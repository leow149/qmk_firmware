+static inline uint32_t pwm_lld_mr_value(const PWMDriver *pwmp, uint32_t value) {
+#if (defined(SN32F280) || defined(SN32F290))
+#if SN32_PWM_USE_CT16B1
+  if (pwmp == &PWMD1) {
+    return value;
+  }
+#endif
+  return CT16_PWM_UNLOCK(value);
+#else
+  (void)pwmp;
+  return value;
+#endif
